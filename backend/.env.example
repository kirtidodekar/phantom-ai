# Leave DATABASE_URL unset to use the local SQLite fallback.
DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<database>?sslmode=require
DATABASE_SCHEMA=sentinel_ai

# ---------------------------------------------------------------------------
# Real-time network monitoring (authorized hosts only)
# ---------------------------------------------------------------------------
# Master switch. When false the platform runs in DEMO/replay mode only.
NETWORK_MONITOR_ENABLED=false
# Interface name, or "auto" to use the system default route interface.
NETWORK_INTERFACE=auto
# Optional BPF capture filter, e.g. "tcp or udp" / "not port 22". Empty = all IP.
PACKET_CAPTURE_FILTER=
# Packet metadata retention horizon in minutes (payloads are never stored).
PACKET_RETENTION_MINUTES=60
# Score at/above which a network threat is escalated for response.
THREAT_THRESHOLD=70
# Sandboxed by default. Enabling real enforcement is an explicit opt-in.
AUTO_BLOCK=false

# --- tuning (optional; sensible defaults applied when omitted) ---
NETWORK_AGGREGATION_WINDOWS=1,5,30,60
NETWORK_DETECTION_INTERVAL=5
PACKET_QUEUE_SIZE=20000
PACKET_MEMORY_BUFFER=2000
PORT_SCAN_UNIQUE_PORTS=15
PORT_SCAN_WINDOW_SECONDS=30
DOS_PACKETS_PER_SECOND=500
DOS_CONNECTIONS_PER_SECOND=100
TRAFFIC_BURST_MULTIPLIER=5
SYN_FLOOD_RATE=100
BASELINE_MIN_SAMPLES=6
# Align network evidence with an existing endpoint/identity entity, e.g.
# NETWORK_LOCAL_ENTITY=user:alice / host:WKS-042
NETWORK_LOCAL_ENTITY=

# Seed simulated replay incidents at startup. Keep false so the dashboard
# shows only real observed telemetry; replay stays available on demand.
DEMO_SEED_ENABLED=false

# ---------------------------------------------------------------------------
# Endpoint + application sensors (four-layer coverage)
# ---------------------------------------------------------------------------
ENDPOINT_SENSOR_ENABLED=false
ENDPOINT_SENSOR_INTERVAL=5
APPLICATION_SENSOR_ENABLED=false
# Comma-separated access log paths, e.g. C:\nginx\logs\access.log,/var/log/nginx/access.log
APPLICATION_LOG_PATHS=
APPLICATION_SENSOR_INTERVAL=5
APPLICATION_LOG_FORMAT=auto
APP_ERROR_RATE_THRESHOLD=0.4

# ---------------------------------------------------------------------------
# Data sovereignty / residency
# ---------------------------------------------------------------------------
# Declare where your datastore physically resides (informational).
DATA_RESIDENCY_REGION=
# Set true to mark third-party managed datastores as non-compliant.
REQUIRE_LOCAL_DATA_RESIDENCY=false
